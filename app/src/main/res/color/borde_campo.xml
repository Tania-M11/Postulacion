<?xml version="1.0" encoding="utf-8"?>
<!-- Borde de los campos de vidrio: blanco pleno al enfocarlo, translúcido en reposo. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/blanco_borde_suave" android:state_enabled="false" />
    <item android:color="@color/blanco" android:state_focused="true" />
    <item android:color="@color/blanco" android:state_hovered="true" />
    <item android:color="@color/blanco_borde_campo" />
</selector>
